# Copy to web/.env.local for local dev.
# Server side only, never NEXT_PUBLIC_.
API_URL=http://localhost:8000

# Accounts (spec 0014), from Supabase → Project Settings → API. Both are public by
# design (the publishable key reads no LabFlow table: row level security, no
# policies). Leave them empty to offer access codes only. Never put the service
# role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
