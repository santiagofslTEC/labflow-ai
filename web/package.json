    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
