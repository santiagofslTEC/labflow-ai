    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "openapi-fetch": "^0.17.0",
    "plotly.js-basic-dist-min": "3.1.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-plotly.js": "2.6.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
