# Copy to api/.env for local dev. Never commit real values.
# Keys below the scaffold line are read once the feature that needs them is built.

# Required: dev or prod (Railway sets prod). `make seed` runs only with dev.
ENV=dev
LOG_LEVEL=INFO
# Supabase dev project, Supavisor session pooler (port 5432). Required: the API refuses to start without it.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Access codes as name:code pairs, comma separated (delete one to revoke it). Optional once
# SUPABASE_URL is set (spec 0014); at least one of the two is required.
ACCESS_CODES=dev:change-me
# Required: signs the access cookie, at least 32 characters. Generate with `openssl rand -hex 32`.
SESSION_SECRET=

# Accounts (spec 0014): the Supabase project URL, e.g. https://abcd1234.supabase.co.
# With it the API accepts Supabase sign ins (Google, email and password); without it only
# ACCESS_CODES work. At least one of the two must be set. Leave ACCESS_CODES empty to turn
# the codes off once everyone has an account (run scripts/assign_shared_notebooks.py first).
SUPABASE_URL=

# --- AI (spec 0006): Ollama Cloud first, Claude as the hedged fallback ---
# fallback (default) · ollama · anthropic · fake (a scripted provider for local clicking; refused in prod)
LLM_PROVIDER=fallback
OLLAMA_HOST=https://ollama.com
# Required in prod; in dev a missing key skips that provider.
OLLAMA_API_KEY=
OLLAMA_MODEL=deepseek-v4.1-flash
# Seconds Ollama gets before Claude starts in parallel, and the whole turn's deadline.
OLLAMA_HEDGE_S=1.5
LLM_DEADLINE_S=4.5
# Required in prod; in dev a missing key skips that provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
CLAUDE_TIMEOUT_S=3
# Per access code holder, sliding hour; reaching it counts as a Claude failure.
CLAUDE_MAX_CALLS_PER_HOUR=30

# --- Reading experiment instructions (spec 0005): optional, these are the defaults ---
# Seconds before Claude joins a setup read, and the whole read's limit (must be greater).
SETUP_HEDGE_S=20
SETUP_DEADLINE_S=45
# Claude's own timeout and output budget for `proponer_cuaderno`.
SETUP_CLAUDE_TIMEOUT_S=25
SETUP_MAX_TOKENS=6000

# --- Voice (spec 0007): optional; without them voice answers 503 and typing keeps working ---
# Server key: signed URLs and scripts/sync_agent.py.
ELEVENLABS_API_KEY=
# Printed by `uv run python scripts/sync_agent.py --env dev`; dev and prod agents differ.
ELEVENLABS_AGENT_ID=
# Shared secret the agent sends to our Custom LLM, at least 32 characters: `openssl rand -hex 32`.
VOICE_LLM_SECRET=
# Public base URL the agent calls: a cloudflared tunnel in dev, the Railway URL in prod.
# Read only by the sync script.
VOICE_LLM_URL=
# Round 2 (spec 0007, AC-22, AC-23): optional. When Claude starts on a voice turn, and when
# the spoken filler "A ver." goes out if the reply is not ready.
# VOICE_HEDGE_S=0.8
# VOICE_FILLER_AFTER_S=1.0
# For scripts/voice_probe.py only (never committed): an access code to sign in with.
# LABFLOW_ACCESS_CODE=
