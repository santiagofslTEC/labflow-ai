{
  "openapi": "3.1.0",
  "info": {
    "title": "LabFlow AI API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Read Health",
        "operationId": "read_health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/access": {
      "post": {
        "tags": [
          "access"
        ],
        "summary": "Grant Access",
        "operationId": "grant_access_api_access_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccessRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessGranted"
                }
              }
            }
          },
          "401": {
            "description": "The code matches no holder",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "The body is not {code: string}",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "More than 5 tries in a minute from this IP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccessGranted": {
        "properties": {
          "holder": {
            "type": "string",
            "title": "Holder"
          }
        },
        "type": "object",
        "required": [
          "holder"
        ],
        "title": "AccessGranted"
      },
      "AccessRequest": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "AccessRequest"
      },
      "ApiErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ApiErrorBody"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "env": {
            "type": "string",
            "enum": [
              "dev",
              "prod"
            ],
            "title": "Env"
          }
        },
        "type": "object",
        "required": [
          "status",
          "env"
        ],
        "title": "Health"
      }
    }
  }
}
