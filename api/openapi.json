{
  "openapi": "3.1.0",
  "info": {
    "title": "LabFlow AI API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Read Health",
        "operationId": "read_health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/access": {
      "post": {
        "tags": [
          "access"
        ],
        "summary": "Grant Access",
        "operationId": "grant_access_api_access_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccessRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessGranted"
                }
              }
            }
          },
          "401": {
            "description": "The code matches no holder",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "The body is not {code: string}",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "More than 5 tries in a minute from this IP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/experiments": {
      "get": {
        "tags": [
          "experiments"
        ],
        "summary": "List Experiments",
        "operationId": "list_experiments_api_experiments_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ExperimentSummary"
                  },
                  "type": "array",
                  "title": "Response List Experiments Api Experiments Get"
                }
              }
            }
          },
          "401": {
            "description": "No valid access session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "experiments"
        ],
        "summary": "Create Experiment",
        "operationId": "create_experiment_api_experiments_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewExperiment"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperimentDetail"
                }
              }
            }
          },
          "401": {
            "description": "No valid access session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "invalid_request, duplicate_variable_name, or invalid_range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/experiments/{experiment_id}": {
      "get": {
        "tags": [
          "experiments"
        ],
        "summary": "Read Experiment",
        "operationId": "read_experiment_api_experiments__experiment_id__get",
        "parameters": [
          {
            "name": "experiment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Experiment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperimentDetail"
                }
              }
            }
          },
          "401": {
            "description": "No valid access session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No notebook with this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "The id is not an integer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccessGranted": {
        "properties": {
          "holder": {
            "type": "string",
            "title": "Holder"
          }
        },
        "type": "object",
        "required": [
          "holder"
        ],
        "title": "AccessGranted"
      },
      "AccessRequest": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "AccessRequest"
      },
      "ApiErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ApiErrorBody"
      },
      "ExperimentDetail": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "goal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Goal"
          },
          "status": {
            "$ref": "#/components/schemas/ExperimentStatus"
          },
          "created_by": {
            "type": "string",
            "title": "Created By"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "variables": {
            "items": {
              "$ref": "#/components/schemas/VariableDetail"
            },
            "type": "array",
            "title": "Variables"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "goal",
          "status",
          "created_by",
          "created_at",
          "variables"
        ],
        "title": "ExperimentDetail",
        "description": "A notebook with its variables in `position` order (spec 0005, AC-16)."
      },
      "ExperimentStatus": {
        "type": "string",
        "enum": [
          "open",
          "closed"
        ],
        "title": "ExperimentStatus"
      },
      "ExperimentSummary": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "$ref": "#/components/schemas/ExperimentStatus"
          },
          "trial_count": {
            "type": "integer",
            "title": "Trial Count"
          },
          "last_activity_at": {
            "type": "string",
            "format": "date-time",
            "title": "Last Activity At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "trial_count",
          "last_activity_at"
        ],
        "title": "ExperimentSummary",
        "description": "One row of the notebook list (spec 0005, AC-14)."
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "env": {
            "type": "string",
            "enum": [
              "dev",
              "prod"
            ],
            "title": "Env"
          }
        },
        "type": "object",
        "required": [
          "status",
          "env"
        ],
        "title": "Health"
      },
      "NewExperiment": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "goal": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Goal"
          },
          "variables": {
            "items": {
              "$ref": "#/components/schemas/NewVariable"
            },
            "type": "array",
            "maxItems": 12,
            "minItems": 1,
            "title": "Variables"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "variables"
        ],
        "title": "NewExperiment"
      },
      "NewVariable": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "min_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Value"
          },
          "max_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Value"
          },
          "required": {
            "type": "boolean",
            "title": "Required",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "NewVariable"
      },
      "VariableDetail": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "min_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Value"
          },
          "max_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Value"
          },
          "required": {
            "type": "boolean",
            "title": "Required"
          },
          "position": {
            "type": "integer",
            "title": "Position"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "unit",
          "min_value",
          "max_value",
          "required",
          "position"
        ],
        "title": "VariableDetail"
      }
    }
  }
}
